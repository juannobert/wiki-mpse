# Dependências do Node (pasta pesada)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Arquivos de ambiente e chaves secretas (se usar no futuro)
.env
.env.local
.env.production

# Arquivos do Sistema Operacional
